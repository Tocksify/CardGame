{
  "name": "aethermancer-desktop",
  "version": "1.0.0",
  "description": "Aethermancer — desktop launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.aethermancer.desktop",
    "productName": "Aethermancer",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "vite.desktop.config.ts",
      "node_modules/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12"
  }
}
